.login-screen-container {
  width: 100vw;
  height: 100vh;
  background-color: #030202;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

/* 顶部暗化叠加层 */
.login-screen-container::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle, transparent 65%, rgba(0, 0, 0, 0.75) 100%),
              linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.12) 50%);
  background-size: 100% 100%, 100% 4px;
  z-index: 5;
  pointer-events: none;
}

/* 固定设计基准 1920x1080 的画布 wrapper */
.login-content-wrapper {
  width: 1920px;
  height: 1080px;
  background-image: url('/bg/SG0_IBG006D.png');
  background-size: 100% 100%;
  background-position: center;
  background-repeat: no-repeat;
  position: absolute;
  transform-origin: center center;
  z-index: 2;
  user-select: none;
}

.left-illustration-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 520px;
  height: 1080px;
  object-fit: cover;
  z-index: 1;
  pointer-events: none;
  border-right: 1px solid rgba(255, 108, 0, 0.1);
}

.salieri-login-form {
  position: relative;
  width: 100%;
  height: 100%;
}

/* Amadeus 金属 Logo 容器定位 */
.amadeus-logo-container {
  position: absolute;
  left: 520px;
  top: 100px;
  width: 880px;
  height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  animation: logo-intro-glitch 1.2s ease-out forwards;
  pointer-events: none;
}

/* 呼吸动画直接作用于透明的 Logo 图上，使其 Drop-Shadow 外发光随轮廓呼吸，完全不影响背景网格 */
.amadeus-logo-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 0 10px rgba(255, 108, 0, 0.35));
  animation: logo-breathing 5s infinite ease-in-out 1.2s;
}

/* 输入框和标签排布 */
.login-field-row {
  position: absolute;
  display: flex;
  align-items: center;
  height: 52px;
}

.userid-row {
  left: 620px; /* 包裹 label 和 input */
  top: 628px;
  width: 632px;
}

.password-row {
  left: 620px;
  top: 694px;
  width: 632px;
}

/* 金黄色等宽文本标签 */
.salieri-label {
  width: 240px; /* 标签固定宽度 */
  text-align: right;
  padding-right: 20px;
  color: #ffaa00;
  font-family: 'Share Tech Mono', 'Courier New', Courier, monospace;
  font-size: 26px;
  font-weight: bold;
  letter-spacing: 1px;
  text-shadow: 0 0 8px rgba(255, 170, 0, 0.7);
  box-sizing: border-box;
}

/* 一比一还原的 CSS 发光输入边框线框 */
.input-border-box {
  width: 392px;
  height: 52px;
  box-sizing: border-box;
  background: rgba(10, 5, 0, 0.75);
  border: 1px solid rgba(255, 108, 0, 0.35);
  border-radius: 1px;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  display: flex;
  align-items: center;
}

/* 输入框聚焦时高亮并向外静态发光（呼吸效果已移至 Logo） */
.box-focused {
  border-color: rgba(255, 170, 0, 0.95);
  background: rgba(15, 8, 2, 0.85);
  box-shadow: 0 0 15px rgba(255, 108, 0, 0.6),
              inset 0 0 8px rgba(255, 108, 0, 0.15);
}

/* 警报错误边框变红（颜色加深为正红） */
.box-error {
  border-color: #cc0000 !important;
  box-shadow: 0 0 15px rgba(204, 0, 0, 0.65) !important;
}

/* 内部输入控件样式 */
.user-id-input, .password-input {
  width: 100%;
  height: 100%;
  background: transparent !important;
  border: none !important;
  outline: none !important;
  color: #ffaa00;
  font-family: 'Share Tech Mono', 'Courier New', Courier, monospace;
  font-size: 26px;
  font-weight: bold;
  padding-left: 14px;
  box-sizing: border-box;
  caret-color: #ffaa00;
  text-shadow: 0 0 8px rgba(255, 170, 0, 0.85);
}

.user-id-input {
  letter-spacing: 1.5px;
}

.password-input {
  letter-spacing: 3px;
}

.user-id-input:disabled, .password-input:disabled {
  color: rgba(255, 170, 0, 0.4);
}

/* 纯正红错误输入文字 */
.box-error .password-input, .box-error .user-id-input {
  color: #cc0000 !important;
  text-shadow: 0 0 8px rgba(204, 0, 0, 0.85);
  caret-color: #cc0000 !important;
}

/* 精准剪裁的圆形红色解密按钮 */
.decrypt-btn {
  position: absolute;
  left: 1251px;
  top: 691px;
  width: 56px;
  height: 56px;
  background-image: url('/assets/images/decrypt_btn_bg.png');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  outline: none;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
  z-index: 10;
}

/* 按钮悬停和点击动效 */
.decrypt-btn:hover:not(:disabled) {
  transform: scale(1.08);
  box-shadow: 0 0 15px rgba(255, 75, 40, 0.85);
  filter: brightness(1.15);
}

.decrypt-btn:active:not(:disabled) {
  transform: scale(0.94);
  filter: brightness(0.9);
}

.decrypt-btn:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

/* 错误提示横幅绝对定位在输入框下方（正红色色调） */
.auth-error-banner {
  position: absolute;
  left: 840px;
  top: 765px;
  width: 392px;
  color: #cc0000;
  font-family: 'Share Tech Mono', 'Courier New', Courier, monospace;
  font-size: 16px;
  font-weight: bold;
  letter-spacing: 1.5px;
  text-align: center;
  text-shadow: 0 0 8px rgba(204, 0, 0, 0.95);
  text-transform: uppercase;
}

/* 错误震颤与 Glitch 闪烁 */
.glitch-flicker {
  animation: error-glitch-flicker-anim 1.2s infinite,
             error-shake 0.3s ease-in-out;
}

/* ================= 动效 Keyframes ================= */

/* 1. 开机 Logo 轻微 Glitch 载入 */
@keyframes logo-intro-glitch {
  0% {
    opacity: 0;
    transform: scale(0.97) skewX(-4deg);
  }
  15% {
    opacity: 0.85;
    transform: scale(1.0) skewX(4deg);
  }
  25% {
    opacity: 0.35;
    transform: scale(0.99) skewX(-2deg);
  }
  35% {
    opacity: 0.95;
    transform: scale(1.0) skewX(0deg);
  }
  100% {
    opacity: 1;
    transform: scale(1.0);
  }
}

/* 2. Logo 自身及其阴影环绕呼吸（完全避免网格线抖动） */
@keyframes logo-breathing {
  0%, 100% {
    transform: scale(1.0);
    filter: drop-shadow(0 0 10px rgba(255, 108, 0, 0.35)) brightness(0.95);
  }
  50% {
    transform: scale(1.008);
    filter: drop-shadow(0 0 24px rgba(255, 108, 0, 0.75)) brightness(1.05);
  }
}

/* 3. 错误提示闪烁 (调为纯正红) */
@keyframes error-glitch-flicker-anim {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.75;
    text-shadow: 0 0 12px rgba(204, 0, 0, 1);
  }
  98% {
    opacity: 1;
  }
  99% {
    opacity: 0.2;
  }
}

/* 4. 错误时的震颤动效 */
@keyframes error-shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-4px); }
  40%, 80% { transform: translateX(4px); }
}

