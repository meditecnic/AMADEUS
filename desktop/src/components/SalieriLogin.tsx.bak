import React, { useState, useEffect } from 'react';
import './SalieriLogin.css';

interface SalieriLoginProps {
  onLoginSuccess: () => void;
}

export const SalieriLogin: React.FC<SalieriLoginProps> = ({ onLoginSuccess }) => {
  const [userId, setUserId] = useState('Salieri');
  const [password, setPassword] = useState('');
  const [errorMsg, setErrorMsg] = useState('');
  const [isAuthenticating, setIsAuthenticating] = useState(false);
  const [scale, setScale] = useState(1);
  const [isIdFocused, setIsIdFocused] = useState(false);
  const [isPwdFocused, setIsPwdFocused] = useState(false);

  // 动态计算 1920x1080 比例下的自适应 scale 值
  useEffect(() => {
    const handleResize = () => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      const scaleFactor = Math.min(w / 1920, h / 1080);
      setScale(scaleFactor);
    };
    
    handleResize();
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!password) {
      setErrorMsg('ACCESS CODE REQUIRED');
      return;
    }

    setIsAuthenticating(true);
    setErrorMsg('');

    try {
      const response = await fetch('/api/auth/salieri', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ username: userId, password }),
      });

      if (response.ok) {
        onLoginSuccess();
      } else {
        const errorData = await response.json().catch(() => ({}));
        setErrorMsg(errorData.detail || 'ACCESS DENIED');
      }
    } catch (error) {
      setErrorMsg('SYSTEM CONNECTION OFFLINE');
    } finally {
      setIsAuthenticating(false);
    }
  };

  return (
    <div className="login-screen-container">
      <div 
        className="login-content-wrapper" 
        style={{ transform: `scale(${scale})` }}
      >
        {/* 左侧助手背影插画 */}
        <img 
          src="/assets/images/left_illustration.png" 
          alt="Illustration" 
          className="left-illustration-img"
        />

        {/* 经典金属质感 Amadeus Logo 区域，带淡入和呼吸动效 */}
        <div className="amadeus-logo-container">
          <img 
            src="/assets/images/amadeus_logo.png" 
            alt="Amadeus System" 
            className="amadeus-logo-img"
          />
        </div>

        <form onSubmit={handleSubmit} className="salieri-login-form">
          {/* USER ID 标签与输入框 */}
          <div className="login-field-row userid-row">
            <span className="salieri-label">USER ID</span>
            <div className={`input-border-box ${isIdFocused ? 'box-focused' : ''}`}>
              <input
                type="text"
                className="user-id-input"
                value={userId}
                onChange={(e) => setUserId(e.target.value)}
                onFocus={() => setIsIdFocused(true)}
                onBlur={() => setIsIdFocused(false)}
                disabled={isAuthenticating}
              />
            </div>
          </div>

          {/* PASSWORD 标签、输入框 */}
          <div className="login-field-row password-row">
            <span className="salieri-label">PASSWORD</span>
            <div className={`input-border-box ${isPwdFocused ? 'box-focused' : ''} ${errorMsg ? 'box-error' : ''}`}>
              <input
                id="salieri-pwd"
                type="password"
                className="password-input"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                onFocus={() => setIsPwdFocused(true)}
                onBlur={() => setIsPwdFocused(false)}
                placeholder=""
                disabled={isAuthenticating}
                autoFocus
              />
            </div>
          </div>
            
          {/* 圆形橙红箭头解密按钮：提升为表单独立子元素，供 CSS 绝对定位对齐 */}
          <button 
            type="submit" 
            className="decrypt-btn"
            disabled={isAuthenticating}
            title="DECRYPT"
            aria-label="Decrypt and Connect"
          />

          {/* 警告横幅 */}
          {errorMsg && (
            <div className="auth-error-banner glitch-flicker">
              {errorMsg}
            </div>
          )}
        </form>
      </div>
    </div>
  );
};


